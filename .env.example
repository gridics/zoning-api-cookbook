GRIDICS_API_KEY=replace_with_your_api_key
GRIDICS_API_BASE_URL=https://api.gridics.com

# Discover these values with recipe 02. Values below are synthetic.
GRIDICS_MARKET_ID=market_example
GRIDICS_PLACE_ID=place_example_county
GRIDICS_PARCEL_ID=parcel_example_001
GRIDICS_APN=000000000001
GRIDICS_ADDRESS=100 Example Ave
GRIDICS_POSTAL_CODE=00000

# Local inspection only; do not use these for production verification.
GRIDICS_DRY_RUN=0
GRIDICS_FIXTURE_MODE=0

# Recipe 18: server-side Location Search (do not expose GRIDICS_API_KEY in a browser)
GRIDICS_LOCATION_QUERY=100 Example Ave
GRIDICS_LOCATION_MODE=suggest_retrieve
GRIDICS_LOCATION_LIMIT=5
GRIDICS_LOCATION_COUNTRY=US
GRIDICS_LOCATION_LANGUAGE=en
GRIDICS_LOCATION_PROXIMITY=
GRIDICS_LOCATION_BBOX=
