    {
      "id": "17",
      "slug": "appraiser-zoning-lookup",
      "title": "Appraiser zoning lookup",
      "level": "business",
      "outcome": "Resolve an appraisal subject by address/APN and report factual zoning with provenance and explicit unknowns.",
      "usage": "One lookup and one optional zoning operation; no uncertain paid retry.",
      "endpoints": [
        "POST /v2/parcels/lookup",
