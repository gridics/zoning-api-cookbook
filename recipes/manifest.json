    },
    {
      "id": "14",
      "slug": "snapshot-diff",
      "title": "Detect changes between property snapshots",
      "level": "business",
      "outcome": "Capture a bounded current snapshot for comparison with a customer-managed prior snapshot.",
      "usage": "Observed response changes are not an ordinance event feed or historical zoning service.",
      "endpoints": [
        "POST /v2/parcels/lookup"
      ],
      "steps": [
        {
          "name": "current_snapshot",
          "method": "POST",
          "path": "/v2/parcels/lookup",
