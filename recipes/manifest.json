    {
      "id": "16",
      "slug": "mcp-tools",
      "title": "Expose bounded MCP tools",
      "level": "advanced",
      "outcome": "Run a read-only MCP-compatible JSON-RPC server with typed, allow-listed Gridics tools.",
      "usage": "Five Gridics calls per workflow, 10 search results, and two zoning enrichments by default.",
      "endpoints": [
        "GET /v2/me",
        "GET /v2/markets",
        "POST /v2/parcels/lookup",
